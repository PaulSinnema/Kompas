@page "/"
@implements IAsyncDisposable
@inject IJSRuntime JS

<PageTitle>Kompas</PageTitle>

<main class="kompas">
    <span class="version">@AppVersion</span>
    <h1>Kompas</h1>

    <div class="dial">
        <svg viewBox="-150 -150 300 300" role="img" aria-label="Kompasroos">
            @* Fixed heading marker *@
            <polygon class="lubber" points="0,-146 -8,-132 8,-132" />

            <g class="rose" style="transform: rotate(@Css(-_rotation)deg)">
                <circle r="130" class="ring" />
                @for (var a = 0; a < 360; a += 5)
                {
                    var major = a % 30 == 0;
                    <line x1="0" y1="-130" x2="0" y2="@(major ? -114 : -123)"
                          class="@(major ? "tick major" : "tick")" transform="rotate(@a)" />
                }
                @* SVG <text> wrapped in <g>: Razor treats a bare <text> in code as a directive *@
                @foreach (var (angle, label) in Cardinals)
                {
                    <g transform="rotate(@angle)">
                        <text x="0" y="-90" class="@(angle == 0 ? "cardinal north" : "cardinal")">@label</text>
                    </g>
                }
                @foreach (var (angle, label) in Intercardinals)
                {
                    <g transform="rotate(@angle)">
                        <text x="0" y="-94" class="intercardinal">@label</text>
                    </g>
                }
                @for (var a = 30; a < 360; a += 30)
                {
                    if (a % 90 == 0) continue;
                    <g transform="rotate(@a)">
                        <text x="0" y="-102" class="degree">@a</text>
                    </g>
                }

                @* Needle: red points north *@
                <polygon class="needle-n" points="0,-70 9,0 -9,0" />
                <polygon class="needle-s" points="0,70 9,0 -9,0" />
                <circle r="6" class="hub" />
            </g>
        </svg>
    </div>

    <div class="readout">
        <span class="deg">@Rounded°</span>
        <span class="dir">@Direction</span>
    </div>

    <p class="status">@_status</p>

    <section class="panels">
        <div class="panel level-panel">
            <h2>Waterpas</h2>
            <svg viewBox="-50 -50 100 100" class="level">
                <circle r="46" class="level-ring" />
                <circle r="10" class="level-target" />
                <line x1="-46" y1="0" x2="46" y2="0" class="level-cross" />
                <line x1="0" y1="-46" x2="0" y2="46" class="level-cross" />
                <circle r="8" cx="@Css(_bubbleX)" cy="@Css(_bubbleY)" class="@(IsLevel ? "bubble flat" : "bubble")" />
            </svg>
            <dl>
                <dt>Voor/achter</dt><dd>@_beta.ToString("F0")°</dd>
                <dt>Links/rechts</dt><dd>@_gamma.ToString("F0")°</dd>
            </dl>
        </div>

        <div class="panel">
            <h2>Locatie</h2>
            @if (_position is { } p)
            {
                <dl>
                    <dt>Breedte</dt><dd>@p.Latitude.ToString("F5")°</dd>
                    <dt>Lengte</dt><dd>@p.Longitude.ToString("F5")°</dd>
                    <dt>Nauwkeurigheid</dt><dd>±@p.Accuracy.ToString("F0") m</dd>
                    <dt>Hoogte</dt><dd>@(p.Altitude is { } alt ? $"{alt:F0} m" : "–")</dd>
                    <dt>Snelheid</dt><dd>@(p.Speed is { } spd ? $"{spd * 3.6:F1} km/u" : "–")</dd>
                    <dt>Koers</dt><dd>@(p.Course is { } crs && p.Speed > 0.5 ? $"{crs:F0}°" : "–")</dd>
                </dl>
            }
            else
            {
                <p class="status">@_geoStatus</p>
            }
        </div>
    </section>
</main>

@code {
    private static readonly (int Angle, string Label)[] Cardinals =
        [(0, "N"), (90, "O"), (180, "Z"), (270, "W")];

    private static readonly (int Angle, string Label)[] Intercardinals =
        [(45, "NO"), (135, "ZO"), (225, "ZW"), (315, "NW")];

    private static readonly string[] Points16 =
        ["N", "NNO", "NO", "ONO", "O", "OZO", "ZO", "ZZO", "Z", "ZZW", "ZW", "WZW", "W", "WNW", "NW", "NNW"];

    // Version from <Version> in Kompas.csproj
    private static readonly string AppVersion =
        typeof(Home).Assembly.GetName().Version is { } v ? $"v{v.Major}.{v.Minor}.{v.Build}" : "";

    private DotNetObjectReference<Home>? _dotNetRef;
    private double _heading;
    private double _rotation; // continuous angle, avoids 359->0 spin
    private string _status = "Kompas starten...";

    private const double BubbleRange = 36; // max bubble offset in level svg units
    private double _beta;
    private double _gamma;
    private double _bubbleX;
    private double _bubbleY;

    private record GeoPosition(double Latitude, double Longitude, double Accuracy, double? Altitude, double? Speed, double? Course);
    private GeoPosition? _position;
    private string _geoStatus = "Locatie ophalen...";

    private bool IsLevel => Math.Abs(_beta) < 2 && Math.Abs(_gamma) < 2;

    private int Rounded => (int)Math.Round(_heading) % 360;

    private string Direction => Points16[(int)Math.Round(_heading / 22.5) % 16];

    private static string Css(double value) => value.ToString("0.##", CultureInfo.InvariantCulture);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        _dotNetRef = DotNetObjectReference.Create(this);

        if (!await JS.InvokeAsync<bool>("kompas.startGeo", _dotNetRef))
            _geoStatus = "Locatie niet beschikbaar.";

        var result = await JS.InvokeAsync<string>("kompas.start", _dotNetRef);
        _status = result switch
        {
            "ok" => "Wachten op sensor...",
            "needs-tap" => "Tik op het scherm om het kompas te starten.",
            "insecure" => "Sensor vereist HTTPS.",
            _ => "Geen kompassensor beschikbaar."
        };
        StateHasChanged();
    }

    [JSInvokable]
    public void OnOrientation(double heading, double beta, double gamma)
    {
        SetHeading(heading);
        SetTilt(beta, gamma);
        _status = "";
        StateHasChanged();
    }

    [JSInvokable]
    public void OnPosition(double latitude, double longitude, double accuracy, double? altitude, double? speed, double? course)
    {
        _position = new GeoPosition(latitude, longitude, accuracy, altitude, speed, course);
        StateHasChanged();
    }

    [JSInvokable]
    public void OnGeoError(int code)
    {
        // Keep last known position on timeout
        if (_position is not null && code == 3) return;
        _position = null;
        _geoStatus = code switch
        {
            1 => "Toegang tot locatie geweigerd.",
            3 => "Geen GPS-signaal.",
            _ => "Locatie niet beschikbaar."
        };
        StateHasChanged();
    }

    private void SetTilt(double beta, double gamma)
    {
        _beta = beta;
        _gamma = gamma;

        // Bubble moves to the high side; 45° tilt = edge
        var x = -gamma / 45 * BubbleRange;
        var y = -beta / 45 * BubbleRange;
        var length = Math.Sqrt(x * x + y * y);
        if (length > BubbleRange)
        {
            x = x / length * BubbleRange;
            y = y / length * BubbleRange;
        }
        _bubbleX = x;
        _bubbleY = y;
    }

    [JSInvokable]
    public void OnStatus(string status)
    {
        _status = status switch
        {
            "waiting" => "Wachten op sensor...",
            "denied" => "Toegang tot de sensor geweigerd.",
            _ => "Geen kompassensor beschikbaar."
        };
        StateHasChanged();
    }

    private void SetHeading(double heading)
    {
        heading = ((heading % 360) + 360) % 360;
        var delta = heading - _heading;
        if (delta > 180) delta -= 360;
        else if (delta < -180) delta += 360;
        _rotation += delta;
        _heading = heading;
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("kompas.stop");
            await JS.InvokeVoidAsync("kompas.stopGeo");
        }
        catch (JSDisconnectedException)
        {
        }
        _dotNetRef?.Dispose();
    }
}
